# Copia este archivo como .env y ajusta la URL segun como corras tu backend Laravel.
#
# Si usas "php artisan serve" (el comando por defecto de Laravel):
VITE_API_URL=http://127.0.0.1:8000/api
#
# Si usas XAMPP con Apache apuntando a la carpeta backend/public, seria algo como:
# VITE_API_URL=http://localhost/rastropet-fullstack/backend/public/api
